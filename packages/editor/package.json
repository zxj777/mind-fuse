{
  "name": "@mind-fuse/editor",
  "version": "0.1.0",
  "description": "PixiJS v8 editor surface for the Mind-Fuse investigation workspace",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "lint": "pnpm exec eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@mind-fuse/ai-sdk": "workspace:*",
    "@mind-fuse/investigation": "workspace:*",
    "@mind-fuse/store": "workspace:*",
    "@mind-fuse/types": "workspace:*",
    "pixi.js": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
